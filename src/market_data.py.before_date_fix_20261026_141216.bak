from datetime import datetime, timedelta
import time

import pandas as pd
import yfinance as yf

from .config import RAW, INITIAL_YEARS, MIN_ROWS


def safe(symbol):
    return "".join(
        char if char.isalnum() or char in "._-" else "_"
        for char in str(symbol)
    )


def path(symbol):
    return RAW / (safe(symbol) + ".csv")


def trading_dates(values):
    """Convert timestamps to Indian trading dates without shifting the date."""
    parsed = pd.to_datetime(values, errors="coerce", utc=True)
    return (
        parsed.dt.tz_convert("Asia/Kolkata")
        .dt.tz_localize(None)
        .dt.normalize()
    )


def read(symbol):
    file_path = path(symbol)
    if not file_path.exists():
        return pd.DataFrame()

    try:
        data = pd.read_csv(file_path)
        if "Date" not in data.columns:
            return pd.DataFrame()

        data["Date"] = trading_dates(data["Date"])
        return (
            data.dropna(subset=["Date"])
            .drop_duplicates("Date", keep="last")
            .sort_values("Date")
            .reset_index(drop=True)
        )
    except (OSError, ValueError, pd.errors.ParserError):
        return pd.DataFrame()


def normalize(data):
    if data is None or data.empty:
        return pd.DataFrame()

    data = data.copy()

    if isinstance(data.columns, pd.MultiIndex):
        data.columns = [
            next(
                (
                    str(part)
                    for part in column
                    if str(part) not in ("", "None")
                ),
                str(column[0]),
            )
            for column in data.columns
        ]

    data = data.reset_index()
    data.columns = [
        str(column).strip().replace(" ", "_")
        for column in data.columns
    ]

    if "Date" not in data.columns and "Datetime" in data.columns:
        data = data.rename(columns={"Datetime": "Date"})

    if "Date" not in data.columns:
        return pd.DataFrame()

    data["Date"] = trading_dates(data["Date"])

    return (
        data.dropna(subset=["Date"])
        .drop_duplicates("Date", keep="last")
        .sort_values("Date")
        .reset_index(drop=True)
    )


def update(symbol, retries=3, force_backfill=False):
    if not symbol:
        return {
            "symbol": symbol,
            "status": "NO_SYMBOL",
            "rows": 0,
            "history_quality": "UNAVAILABLE",
            "error": "No provider symbol",
        }

    old = read(symbol)
    previous_rows = len(old)
    today = datetime.now().date()

    # Backfill automatically for a missing file.
    # Reattempt an existing short history only when explicitly requested.
    needs_backfill = old.empty or force_backfill

    if needs_backfill:
        start = (
            datetime.now() - timedelta(days=365.25 * INITIAL_YEARS)
        ).date()
        mode = "BACKFILL"
    else:
        last_date = old["Date"].max()
        start = (last_date - pd.Timedelta(days=5)).date()
        mode = "INCREMENTAL"

    errors = []
    fresh = pd.DataFrame()
    end = (today + timedelta(days=1)).isoformat()

    for attempt in range(max(1, retries)):
        try:
            downloaded = yf.download(
                symbol,
                start=start.isoformat(),
                end=end,
                auto_adjust=False,
                actions=True,
                progress=False,
                threads=False,
                timeout=30,
            )
            fresh = normalize(downloaded)

            if not fresh.empty:
                break

            errors.append("Provider returned no rows")
        except Exception as exc:
            errors.append(f"{type(exc).__name__}: {exc}")

        if attempt + 1 < max(1, retries):
            time.sleep(attempt + 1)

    if fresh.empty:
        latest = (
            str(old["Date"].max().date())
            if not old.empty
            else ""
        )
        return {
            "symbol": symbol,
            "status": "NO_NEW_DATA" if not old.empty else "FAILED",
            "mode": mode,
            "previous_rows": previous_rows,
            "rows": previous_rows,
            "latest_date": latest,
            "history_quality": (
                "ADEQUATE" if previous_rows >= MIN_ROWS
                else "SHORT_HISTORY"
            ),
            "error": "; ".join(errors),
        }

    # Merge old and fresh data. Keep the union of dates and columns.
    combined = pd.concat([old, fresh], ignore_index=True, sort=False)
    combined["Date"] = trading_dates(combined["Date"])
    combined = combined.dropna(subset=["Date"]).sort_values("Date")

    # Keep the latest non-null value per field/date, then restore any
    # older non-null values missing from the provider's overlapping rows.
    combined = (
        combined.groupby("Date", as_index=False, sort=True)
        .last()
        .sort_values("Date")
    )

    if not old.empty:
        old_by_date = (
            old.drop_duplicates("Date", keep="last")
            .set_index("Date")
        )
        merged_by_date = combined.set_index("Date")
        merged_by_date = merged_by_date.combine_first(old_by_date)
        combined = merged_by_date.reset_index().sort_values("Date")

    combined = (
        combined.drop_duplicates("Date", keep="last")
        .reset_index(drop=True)
    )

    # Validate before replacing the existing CSV.
    if combined.empty or combined["Date"].isna().any():
        raise ValueError(
            f"Refusing to save invalid history for {symbol}"
        )

    destination = path(symbol)
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(destination.name + ".tmp")

    try:
        combined.to_csv(temporary, index=False)
        check = pd.read_csv(temporary)
        if "Date" not in check.columns or len(check) != len(combined):
            raise ValueError("Temporary CSV validation failed")
        temporary.replace(destination)
    except Exception:
        if temporary.exists():
            temporary.unlink()
        raise

    row_count = len(combined)
    quality = "ADEQUATE" if row_count >= MIN_ROWS else "SHORT_HISTORY"

    return {
        "symbol": symbol,
        "status": "UPDATED",
        "mode": mode,
        "previous_rows": previous_rows,
        "rows": row_count,
        "latest_date": str(combined["Date"].max().date()),
        "history_quality": quality,
        "error": "",
    }


def history(symbol, refresh=False):
    if refresh:
        update(symbol)

    data = read(symbol)

    if not data.empty:
        data = (
            data.dropna(subset=["Date"])
            .drop_duplicates("Date", keep="last")
            .sort_values("Date")
            .reset_index(drop=True)
        )

    return data
